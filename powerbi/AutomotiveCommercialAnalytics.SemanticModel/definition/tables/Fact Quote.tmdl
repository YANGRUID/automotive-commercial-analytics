table 'Fact Quote'
	lineageTag: 89bd06cc-fc0b-4807-84e6-c99f46e45884

	measure 'Total Quotes' = DISTINCTCOUNT ( 'Fact Quote'[quote_id] )
		formatString: #,##0
		displayFolder: Volume
		lineageTag: e6028fb3-7c3c-4623-ae96-bd5aafe7bb40

	measure 'Total Quotes by Quote Date' = CALCULATE ( [Total Quotes], USERELATIONSHIP ( 'Dim Date'[date], 'Fact Quote'[quote_date] ), CROSSFILTER ( 'Dim Date'[date], 'Fact Inquiry'[inquiry_date], NONE ) )
		formatString: #,##0
		displayFolder: Volume
		lineageTag: cc03147a-b63c-4b14-8856-3e1f76fe9a98

	measure 'Average Quote' = AVERAGE ( 'Fact Quote'[quote_amount] )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: 64655bc4-87ee-4dbc-992a-6c79475b6339

	measure 'Maximum Quote' = MAX ( 'Fact Quote'[quote_amount] )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: a559e39c-3139-494e-a1f0-fd3a1194aaf9

	measure 'Minimum Quote' = MIN ( 'Fact Quote'[quote_amount] )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: bfcf1910-a887-4c56-8fc9-ac9c8486768f

	measure 'Median Quote' = MEDIAN ( 'Fact Quote'[quote_amount] )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: 7bcfe0d7-d384-48a4-b855-086e0eb57006

	measure 'Total Accepted Quote Value' = CALCULATE ( SUM ( 'Fact Quote'[quote_amount] ), KEEPFILTERS ( 'Fact Quote'[accepted_flag] = TRUE () ) )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: 2ea861f8-2722-4cfc-800b-5ecf51466d0f

	measure 'Quote-to-Market Ratio' = DIVIDE ( SUM ( 'Fact Quote'[quote_amount] ), SUM ( 'Fact Quote'[estimated_market_value] ) )
		formatString: 0.0%
		displayFolder: Pricing
		lineageTag: 47c43585-d4fd-430b-bd80-1f67c7ca506c

	measure 'Quote Anomalies' = CALCULATE ( [Total Quotes], KEEPFILTERS ( 'Fact Quote'[anomaly_flag] = TRUE () ) )
		formatString: #,##0
		displayFolder: Pricing
		lineageTag: 8f417c99-3406-4e5f-8bdf-5c8422892097

	measure 'Quote Anomaly Rate' = DIVIDE ( [Quote Anomalies], [Total Quotes] )
		formatString: 0.00%
		displayFolder: Pricing
		lineageTag: 3a61180a-7931-4208-be81-71ed34f8c53f

	measure 'Average Estimated Market Value' = AVERAGE ( 'Fact Quote'[estimated_market_value] )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: 17e65dea-c81f-4a87-875a-f16d5068d05f

