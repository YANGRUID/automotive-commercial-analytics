table 'Fact Inquiry'
	lineageTag: 04618eaa-f83b-4fc5-95cd-c2e9865923ff

	measure 'Total Inquiries' = DISTINCTCOUNT ( 'Fact Inquiry'[inquiry_id] )
		formatString: #,##0
		displayFolder: Volume
		lineageTag: a319ee8c-e02f-473a-9340-7b975a6ea6b4

	measure 'Converted Inquiries' = CALCULATE ( [Total Inquiries], KEEPFILTERS ( 'Fact Inquiry'[conversion_flag] = TRUE () ) )
		formatString: #,##0
		displayFolder: Conversion
		lineageTag: f942c03b-317d-4135-8108-0da175505b45

	measure 'Conversion Rate' = DIVIDE ( [Converted Inquiries], [Total Inquiries] )
		formatString: 0.0%
		displayFolder: Conversion
		lineageTag: a82a6194-781b-4068-8773-ad5518ae058a

	measure 'Average Quotes per Inquiry' = DIVIDE ( [Total Quotes], [Total Inquiries] )
		formatString: 0.00
		displayFolder: Volume
		lineageTag: de620f13-3a5d-46e8-9331-c3444f6b6638

	measure 'Average Days to Conversion' = CALCULATE ( AVERAGE ( 'Fact Inquiry'[days_to_conversion] ), KEEPFILTERS ( 'Fact Inquiry'[conversion_flag] = TRUE () ) )
		formatString: 0.0 "days"
		displayFolder: Conversion
		lineageTag: 05f5839f-2a64-44d5-a2f4-0a063acc2b4e

	measure 'Inquiries Under 8h SLA' = CALCULATE ( [Total Inquiries], KEEPFILTERS ( 'Fact Inquiry'[fastest_response_hours] < 8 ) )
		formatString: #,##0
		displayFolder: Conversion
		lineageTag: 8d5f8789-b862-45c1-9525-94134dc7e6b4

	measure '8h SLA Compliance Rate' = DIVIDE ( [Inquiries Under 8h SLA], [Total Inquiries] )
		formatString: 0.0%
		displayFolder: Conversion
		lineageTag: e5befa3b-e3da-406f-be90-4eca3fcb6dd4

	measure 'Average Highest Quote' = AVERAGE ( 'Fact Inquiry'[highest_quote] )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: f3b06932-ae22-46bb-8f68-5bf8b54b1d54

	measure 'Average Lowest Quote' = AVERAGE ( 'Fact Inquiry'[lowest_quote] )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: 82206433-d279-4008-8a2c-56371b79efe5

	measure 'Average Quote Spread' = AVERAGE ( 'Fact Inquiry'[quote_spread] )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: ea4b017f-fd53-486c-afd6-4441763dadb6

	measure 'Average Quote Spread %' = AVERAGE ( 'Fact Inquiry'[quote_spread_pct] )
		formatString: 0.0%
		displayFolder: Pricing
		lineageTag: b119524f-b905-489a-8d8b-f0589dc71093

	measure 'Average Sale Value' = CALCULATE ( AVERAGE ( 'Fact Inquiry'[final_sale_price] ), KEEPFILTERS ( 'Fact Inquiry'[conversion_flag] = TRUE () ) )
		formatString: CHF #,##0
		displayFolder: Pricing
		lineageTag: 3e86c188-a6d2-4024-a100-271495cdd50a

	measure 'Average Fastest Response Time' = AVERAGE ( 'Fact Inquiry'[fastest_response_hours] )
		formatString: 0.0 "h"
		displayFolder: Dealer
		lineageTag: 321aa2be-8900-497b-a48d-4da759dc15e3

	measure 'Previous Month Inquiries' = CALCULATE ( [Total Inquiries], DATEADD ( 'Dim Date'[date], -1, MONTH ) )
		formatString: #,##0
		displayFolder: Time Intelligence
		lineageTag: 385855c2-e27d-4185-9090-041f526d549a

	measure 'Month-over-Month Inquiry Growth' = DIVIDE ( [Total Inquiries] - [Previous Month Inquiries], [Previous Month Inquiries] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: 93591e8b-2487-4ef9-8c5a-c9032e35131c

	measure 'Previous Year Inquiries' = CALCULATE ( [Total Inquiries], SAMEPERIODLASTYEAR ( 'Dim Date'[date] ) )
		formatString: #,##0
		displayFolder: Time Intelligence
		lineageTag: b2fecab8-a540-453f-bde4-86298e78afa7

	measure 'Year-over-Year Inquiry Growth' = DIVIDE ( [Total Inquiries] - [Previous Year Inquiries], [Previous Year Inquiries] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: b96c52ba-48f1-4926-a4d2-f26a1c3cf028

	measure 'Previous Month Conversion Rate' = CALCULATE ( [Conversion Rate], DATEADD ( 'Dim Date'[date], -1, MONTH ) )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 6bbe0ce8-8ea8-46b4-ac36-7d9ae8bc8ad1

	measure 'Conversion Rate Change' = [Conversion Rate] - [Previous Month Conversion Rate]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence
		lineageTag: 164011e2-2540-4ffe-8f45-8398fce15257

	measure 'Rolling 3M Conversion Rate' = VAR LastVisibleDate = MAX ( 'Dim Date'[date] ) VAR ThreeMonthWindow = DATESINPERIOD ( 'Dim Date'[date], LastVisibleDate, -3, MONTH ) RETURN DIVIDE ( CALCULATE ( [Converted Inquiries], ThreeMonthWindow ), CALCULATE ( [Total Inquiries], ThreeMonthWindow ) )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 17781313-0db7-4f6c-9285-6f4734ef52fd

