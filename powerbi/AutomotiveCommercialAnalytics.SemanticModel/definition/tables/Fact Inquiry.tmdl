	column 'Response Time Band' = SWITCH ( TRUE (), 'Fact Inquiry'[fastest_response_hours] < 2, "Under 2 hours", 'Fact Inquiry'[fastest_response_hours] < 4, "2-4 hours", 'Fact Inquiry'[fastest_response_hours] < 8, "4-8 hours", 'Fact Inquiry'[fastest_response_hours] < 12, "8-12 hours", "12+ hours" )
		dataType: string
		lineageTag: c9cdf038-2043-4f6d-b21a-b4df3ba29e6f
		summarizeBy: none
		sortByColumn: 'Response Time Band Sort'

	column 'Response Time Band Sort' = SWITCH ( TRUE (), 'Fact Inquiry'[fastest_response_hours] < 2, 1, 'Fact Inquiry'[fastest_response_hours] < 4, 2, 'Fact Inquiry'[fastest_response_hours] < 8, 3, 'Fact Inquiry'[fastest_response_hours] < 12, 4, 5 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a3e60dff-7b05-4dbc-bb2f-030e0f9eaad4
		summarizeBy: none

	partition 'Fact Inquiry' = m
		mode: import
		source =
